# Copy this file to .env and fill it in. Never commit the real .env.

# A long random secret used to sign session cookies.
# Generate one (PowerShell):  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
SESSION_SECRET=

# ---- Paystack TEST keys (payments sandbox — see PAYMENTS_DECISION.md) ----
# TEST keys only for now. They start with  sk_test_  (secret) and
# pk_test_  (public). Real (live) keys must NEVER be stored until the
# business is verified with the provider — and they still live ONLY
# in this file, never in source code, never sent to the browser.
PSTK_SECRET_TEST_KEY=
PSTK_PUBLIC_TEST_KEY=
